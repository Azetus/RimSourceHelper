    "dev:mcp": "pnpm --filter rimsourcehelper-mcp dev"
  },
  "keywords": [],
  "author": "Aliza",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "ignore"
    }
  }
}
