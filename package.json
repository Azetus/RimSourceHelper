{
  "name": "rimsourcehelper",
  "version": "1.0.0",
  "description": "RimWorld modding knowledge base - MCP Server + DLL Analyzer",
  "private": true,
  "type": "module",
  "scripts": {
     "clean": "node scripts/clean-release.mjs",
    "build": "pnpm run clean && pnpm run build:analyzer && pnpm run build:mcp && pnpm run build:mcp-deps && pnpm run build:copy",
    "build:analyzer": "dotnet publish packages/rim-analyzer -c Release",
    "build:mcp": "node esbuild.mjs",
    "build:mcp-deps": "node scripts/copy-mcp-deps.mjs",
    "build:copy": "node scripts/copy-release-files.mjs",
    "typecheck": "pnpm --filter rimsourcehelper-mcp exec tsc --noEmit",
    "dev:mcp": "pnpm --filter rimsourcehelper-mcp dev"
  },
  "keywords": [],
  "author": "Aliza",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  }
}
