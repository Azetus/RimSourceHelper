{
  "name": "rimsourcehelper",
  "version": "1.0.0",
  "description": "RimWorld modding knowledge base - MCP Server + DLL Analyzer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs release",
    "build:local": "node scripts/build.mjs local-run",
